# Copy this file to `.env` (same folder) and fill in your own values.
# `.env` is ignored by git, so your real keys never reach GitHub.

PORT=4000

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler" (URI).
# Replace [YOUR-PASSWORD] with your database password. If it contains special characters
# such as @ # / : ? %, percent-encode them (for example @ -> %40).
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
